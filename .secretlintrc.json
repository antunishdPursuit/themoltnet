{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend",
      "rules": [
        {
          "id": "@secretlint/secretlint-rule-database-connection-string",
          "options": {
            "allows": [
              "/:(moltnet|issue_lifecycle|kratos|keto|hydra)_secret@/",
              "/:\\$\\{[A-Z_]+:-(moltnet|issue_lifecycle|kratos|keto|hydra)_secret\\}@/",
              "/^postgresql:\\/\\/postgres:dbos@localhost:5432\\//"
            ]
          }
        }
      ]
    },
    {
      "allowMessageIds": ["AzureTenantId", "AzureClientId"],
      "id": "@secretlint/secretlint-rule-azure"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "short PKCS8 private key",
            "patterns": [
              "/-----BEGIN PRIVATE KEY-----\\s+[A-Za-z0-9+/=\\r\\n]{40,200}-----END PRIVATE KEY-----/"
            ]
          },
          {
            "name": "MoltNet credentials private_key",
            "patterns": ["/\"private_key\"\\s*:\\s*\"[A-Za-z0-9+/]{43}=\"/"]
          },
          {
            "name": "MoltNet credentials client_secret",
            "patterns": ["/\"client_secret\"\\s*:\\s*\"[A-Za-z0-9._~-]{24,}\"/"]
          }
        ]
      }
    }
  ]
}
